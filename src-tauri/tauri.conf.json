{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PointSpeak",
  "version": "1.0.0",
  "identifier": "com.pointspeak.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "PointSpeak — Configurações",
        "url": "settings.html",
        "width": 720,
        "height": 560,
        "visible": false
      },
      {
        "label": "hud",
        "title": "PointSpeak HUD",
        "url": "hud.html",
        "width": 220,
        "height": 56,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "resources": {
      "resources/silero_vad.onnx": "resources/silero_vad.onnx",
      "resources/silero_vad-LICENSE.txt": "licenses/silero_vad-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2"],
        "recommends": ["wtype", "ydotool"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
